// GPLv3 M832D driver definition.  The filter owns option interpretation.
#include <font.defs>
#include <media.defs>
#include <label.h>

Manufacturer "Phomemo"
Version 1.0
DriverType label
ColorDevice No
Attribute "cupsSNMPSupplies" "" "false"
HWMargins 0 0 0 0

#media "w53h70/Label 53mm x 70mm" 53mm 70mm
#media "w80h106/Label 80mm x 106mm" 80mm 106mm
#media "w110h146/Label 110mm x 146mm" 110mm 146mm
#media "Letter/Letter" 8.5in 11in
#media "A4/A4" 210mm 297mm

Filter "application/vnd.cups-raster 100 rastertom832d"
*Resolution - 8 0 0 0 300dpi
ColorModel Gray/Grayscale w chunky 0

*MediaSize "w53h70"
MediaSize "w80h106"
MediaSize "w110h146"
MediaSize "Letter"
MediaSize "A4"
VariablePaperSize Yes
MinSize 53mm 70mm
MaxSize 613mm 5700mm

{
  Attribute "NickName" "" "Phomemo M832D"
  ModelName "M832D"
  PCFileName "Phomemo-M832D.ppd"
  Option "M832DDensity/Density" PickOne DocumentSetup 10
  *Choice "Default/Default" ""
  Choice "Light/Light" ""
  Choice "Heavy/Heavy" ""
  Option "M832DHeat/Heat" PickOne DocumentSetup 10
  *Choice "Default/Default" ""
  Choice "Slow/Slow" ""
  Choice "Fast/Fast" ""
  Option "M832DThreshold/Threshold" PickOne AnySetup 10
  *Choice "160/160" ""
  Choice "128/128" ""
  Choice "192/192" ""
  Option "M832DFeed/Feed" PickOne DocumentSetup 10
  *Choice "2/2" ""
  Choice "6/6" ""
  Option "M832DRotation/Rotation" PickOne AnySetup 10
  *Choice "0/0" ""
  Choice "90/90" ""
  Choice "180/180" ""
  Choice "270/270" ""
  Option "M832DOffsetX/Horizontal offset" PickOne AnySetup 10
  *Choice "0/0" ""
  Choice "8/8" ""
  Option "M832DOffsetY/Vertical offset" PickOne AnySetup 10
  *Choice "0/0" ""
  Choice "8/8" ""
}
